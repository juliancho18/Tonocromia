# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL=

# Vercel Blob storage token. Locally: `vercel env pull` after linking the
# project, or create a store in the Vercel dashboard and copy its token.
BLOB_READ_WRITE_TOKEN=

# Password the investigator types to reach /panel.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
ADMIN_SESSION_SECRET=
